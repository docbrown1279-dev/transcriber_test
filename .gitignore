# Secrets
.env

.trash/

# Local Cursor (orchestrator, hooks, skills) — keep slash-commands + permissions in git
.cursor/*
!.cursor/commands/
!.cursor/commands/**
!.cursor/permissions.json

# Virtualenvs 
.venv/
.venv-*/
# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.DS_Store
.worktrees/

# Logs
logs/
*.log
!logs/.gitkeep

# working data 
docs/
data/
!data/.gitkeep

# Model weights (root cache only — do not ignore src/**/models/)
/models/
*.gguf

# Run artifacts (decisions live under docs/research_results/)
results/*
!results/.gitkeep

# Exchange with cloud agents is tracked (cloud_in/ -> cloud_out/); prompt archive is local
prompts/

# App runtime data (jobs, uploads, artifacts)
var/

# Gold JSON in eval
eval/
!eval/.gitkeep


