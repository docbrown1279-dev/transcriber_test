  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 1.952,
      "speaker": "SPEECH",
      "text": "а давайте так поступим"
    },
    {
      "id": 1,
      "start": 2.448,
      "end": 9.184,
      "speaker": "SPEECH",
      "text": "планы разрезы для а игорь то есть смотрите мы смотрим по предыдущим корпусам да сравниваем мощность"
    },
    {
      "id": 2,
      "start": 10.064,
      "end": 11.968,
      "speaker": "SPEECH",
      "text": "если у нас мощность условно там"
    },
    {
      "id": 3,
      "start": 12.304,
      "end": 15.856,
      "speaker": "SPEECH",
      "text": "корпуса там девятого совпадает там с восьмым или с каким то да"
    },
    {
      "id": 4,
      "start": 16.704,
      "end": 17.808,
      "speaker": "SPEECH",
      "text": "мы говорим что"
    },
    {
      "id": 5,
      "start": 18.496,
      "end": 19.728,
      "speaker": "SPEECH",
      "text": "у нас все тоже самое"
    },
    {
      "id": 6,
      "start": 20.032,
      "end": 20.048,
      "speaker": "SPEECH",
      "text": ""
    },
    {
      "id": 7,
      "start": 20.4,
      "end": 28.016,
      "speaker": "SPEECH",
      "text": "если ну да если нет трансформаторы могут отличаться по мощности по массово габаритным характеристикам они будут одинаковые примерно"
    },
    {
      "id": 8,
      "start": 28.496,
      "end": 31.584,
      "speaker": "SPEECH",
      "text": "просто как уж больше будет"
    },
    {
      "id": 9,
      "start": 32.24,
      "end": 32.88,
      "speaker": "SPEECH",
      "text": "москве"
    },
    {
      "id": 10,
      "start": 33.408,
      "end": 41.984,
      "speaker": "SPEECH",
      "text": "вот если это так вы смотрите да действительно с такой же все по высоте по габаритам прошло расстояние там от стены там от входа и прочее"
    },
    {
      "id": 11,
      "start": 42.288,
      "end": 42.624,
      "speaker": "SPEECH",
      "text": "вот"
    },
    {
      "id": 12,
      "start": 43.088,
      "end": 46.352,
      "speaker": "SPEECH",
      "text": "ничего нового не делают сейчас на данном этапе надо заложить их"
    },
    {
      "id": 13,
      "start": 46.672,
      "end": 47.184,
      "speaker": "SPEECH",
      "text": "и но"
    },
    {
      "id": 14,
      "start": 47.584,
      "end": 50.624,
      "speaker": "SPEECH",
      "text": "зарисовать помещение и максимально быстро дать ресурс"
    },
    {
      "id": 15,
      "start": 51.056,
      "end": 53.904,
      "speaker": "SPEECH",
      "text": "у вас было понимаешь что не надо к ней че приколовку"
    },
    {
      "id": 16,
      "start": 57.792,
      "end": 62.4,
      "speaker": "SPEECH",
      "text": "другого варианта нету потому что ну это не москва"
    },
    {
      "id": 17,
      "start": 63.264,
      "end": 65.376,
      "speaker": "SPEECH",
      "text": "а четких требований у них нету"
    },
    {
      "id": 18,
      "start": 65.84,
      "end": 66.992,
      "speaker": "SPEECH",
      "text": "все идет"
    },
    {
      "id": 19,
      "start": 67.6,
      "end": 72.496,
      "speaker": "SPEECH",
      "text": "и прочее направить получить согласование потом этим бумажками махают все"
    },
    {
      "id": 20,
      "start": 75.008,
      "end": 80.992,
      "speaker": "SPEECH",
      "text": "другого варианта у нас работать с ними к сожалению нет потому что они потом от могут просто отказаться"
    },
    {
      "id": 21,
      "start": 81.632,
      "end": 81.76,
      "speaker": "SPEECH",
      "text": ""
    },
    {
      "id": 22,
      "start": 82.464,
      "end": 82.48,
      "speaker": "SPEECH",
      "text": ""
    },
    {
      "id": 23,
      "start": 82.928,
      "end": 84.608,
      "speaker": "SPEECH",
      "text": "бумага все"
    }
